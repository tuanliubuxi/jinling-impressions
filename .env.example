# 后续接入真实模型时使用；只允许服务端读取，不要加 NEXT_PUBLIC_ 前缀。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# 手机访问开发服务时，填写电脑局域网 IP（只写主机名，不含 http:// 或端口）。
DEV_ALLOWED_ORIGINS=**.cpolar.top
# 支持 *.domain 单级子域、**.domain 多级子域；来源包含协议，可用逗号分隔。
PUBLIC_APP_ORIGINS=https://**.cpolar.top,http://**.cpolar.top
